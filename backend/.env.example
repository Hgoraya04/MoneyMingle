# Neon connection string — from your Neon project dashboard, "Connection string" (Prisma / psql format).
# Looks like: postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/moneymingle?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Any long random string — used to sign login sessions (JWTs). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

PORT=4000
