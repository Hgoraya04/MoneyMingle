generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  accounts     Account[]
  goals        Goal[]
  transactions Transaction[]
}

model Account {
  id              String   @id @default(cuid())
  userId          String
  name            String
  previousBalance Decimal  @default(0) @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
}

model Goal {
  id           String    @id @default(cuid())
  userId       String
  name         String
  targetAmount Decimal   @db.Decimal(12, 2)
  targetDate   DateTime?
  accomplished Boolean   @default(false)
  createdAt    DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
}

model Transaction {
  id     String @id @default(cuid())
  userId String
  goalId String

  accountId String
  date      DateTime
  description String
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType

  // Withdrawals only. true = this goal's saved-so-far drops by `amount` (money
  // leaving the goal for something else, or a reallocation's source leg).
  // false = the goal's saved-so-far is unchanged (spending money already
  // counted as saved, e.g. an actual tuition payment out of an education goal).
  // Always null for deposits.
  reduceGoalAmount Boolean?

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal    Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, goalId])
  @@index([userId, accountId])
}
